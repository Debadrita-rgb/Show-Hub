<div style="font-family: Arial; background:#f2f2f2; padding:20px;">
  <div
    style="max-width:600px; margin:auto; background:#fff; border-radius:10px; overflow:hidden;"
  >

    <!-- HEADER -->
    <div
      style="background: linear-gradient(135deg, #000, #4c1d95); color:white; padding:20px;"
    >
      <h2>❌ Booking Cancelled</h2>
    </div>

    <!-- BODY -->
    <div style="padding:20px;">
      <p>Hi {{name}},</p>

      <p>Your booking has been <b>{{cancelType}}</b> cancelled.</p>

      <p><b>Booking ID:</b> {{bookingId}}</p>
      <p><b>Movie:</b> {{movieTitle}}</p>
      <p><b>Theater:</b> {{theaterName}}</p>
      {{!-- <p>
        <b>Date:</b>
        {{showDate}}
        <br />
        <b>Time:</b>
        {{showTime}}
      </p> --}}
      {{#if seats}}
        <p><b>Cancelled Seats:</b> {{seats}}</p>
      {{/if}}

      <p><b>Refund Amount:</b> ₹{{refundAmount}}</p>

      <p style="color:gray;">Refund will be processed within 5–7 business days.</p>

      <br />
      <p>
        –
        <a
          href="https://show-hub-frontend.onrender.com"
          style="color:#4c1d95; text-decoration:none; font-weight:bold;"
        >
          ShowHub 🎬
        </a>
      </p>
    </div>

  </div>
</div>